# 复制为 .env.production 后填值；真实文件不提交（已在 .gitignore）
ADMIN_PASSWORD=change-me

# SoundCloud（cookie 可留空；OAuth 用于一键绑定）
NETEASE_COOKIE=
BILIBILI_SESSDATA=

# SoundCloud OAuth（注册应用后获得；redirect_uri 必须与注册值完全一致）
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=https://your-domain:port/api/soundcloud/callback
